[Unit]
Description=pairscan collector for the ETF-Pair Combo Spread board
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/etf-pair-arbitrage
# The PostgreSQL DSN (deploy/install.sh writes it).
EnvironmentFile=/home/ubuntu/code/etf-pair-arbitrage/dashboard/.env
ExecStart=/home/ubuntu/code/etf-pair-arbitrage/dashboard/run/pairscan -config dashboard/config.yaml
StandardOutput=append:/home/ubuntu/code/etf-pair-arbitrage/dashboard/run/pairscan.log
StandardError=inherit
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
